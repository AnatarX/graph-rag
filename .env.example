# LLM-провайдер: любой OpenAI-совместимый API. Код (llm_client.py) не привязан к
# конкретному провайдеру — переключается через LLM_BASE_URL/LLM_*_MODEL ниже.
# Три проверенных варианта:
#
# 1) Ollama локально (бесплатно, без ключей, без ограничений по региону).
#    Установи https://ollama.com, затем:
#      ollama pull qwen2.5:7b-instruct && ollama pull qwen2.5:3b-instruct && ollama pull bge-m3
#      ollama serve   # держать запущенным во время пайплайна
#    LLM_API_KEY=ollama
#    LLM_BASE_URL=http://localhost:11434/v1
#    LLM_CHAT_MODEL=qwen2.5:7b-instruct
#    LLM_EMBED_MODEL=bge-m3
#    # 7b — для ответов в чате (заметно меньше врёт). Разовую экстракцию графа по
#    # 100 документам гонял на 3b: на CPU это ~1.5 часа против многих часов на 7b.
#    # Чтобы повторить так же — временно поставь здесь 3b на время `pipeline build`.
#    LLM_FREQUENCY_PENALTY=0.3
#    # Маленькие модели на temperature=0 срываются в повторяющийся луп генерации, упираются
#    # в max_tokens и вызывают дорогой ретрай (на шумном корпусе это давало ~2.6 LLM-вызова
#    # на документ вместо одного). frequency_penalty — СТАНДАРТНЫЙ параметр OpenAI API,
#    # поэтому работает и здесь, и у облачных провайдеров.
#    #
#    # ВАЖНО про LLM_EXTRA_OPTIONS (ниже): на Ollama через /v1 он НЕ РАБОТАЕТ. Её
#    # OpenAI-совместимый эндпоинт молча игнорирует поле options — запрос с
#    # {"options": {"num_predict": 5}} спокойно генерирует 81 токен (проверено). То есть
#    # num_ctx/num_thread/repeat_penalty так задать нельзя. Собственные опции Ollama
#    # задаются в Modelfile:
#    #   printf 'FROM qwen2.5:7b-instruct\nPARAMETER num_ctx 3072\n' > Modelfile
#    #   ollama create qwen-ctx3072 -f Modelfile
#    # и дальше LLM_CHAT_MODEL=qwen-ctx3072.
#
# 2) cloud.ru Foundation Models — статический API-ключ (личный кабинет ->
#    Foundation Models -> Create API Key), используется напрямую как Bearer-токен.
#    LLM_BASE_URL=https://foundation-models.api.cloud.ru/v1
#    LLM_CHAT_MODEL=openai/gpt-oss-120b
#    LLM_EMBED_MODEL=openai/text-embedding-3-small
#
# 3) OpenRouter / Groq — тот же паттерн: свой base_url + свой ключ в LLM_API_KEY,
#    имя модели с их площадки в LLM_CHAT_MODEL и LLM_EMBED_MODEL. OpenRouter отдаёт
#    embeddings через /embeddings (на нём в этом проекте гонялся тот же
#    openai/text-embedding-3-small, что и в варианте (2) выше, просто через другого
#    провайдера) — Groq на момент написания этого README embeddings не отдавал вообще
#    (не конкретную модель, а API как таковое), проверь актуальное состояние на их сайте.
LLM_API_KEY=
LLM_BASE_URL=https://foundation-models.api.cloud.ru/v1
LLM_CHAT_MODEL=openai/gpt-oss-120b
LLM_EMBED_MODEL=openai/text-embedding-3-small
# Штраф за повтор токенов (стандартный параметр OpenAI API). 0 — выключено; для
# маленьких локальных моделей полезно 0.2-0.4, см. блок про Ollama выше.
LLM_FREQUENCY_PENALTY=0

# Какой датасет собирать: bbc | 20newsgroups (см. ingest.DATASET_LOADERS).
# Артефакты каждого лежат отдельно, в artifacts/<dataset>/, и не затирают друг друга.
DATASET=bbc
N_DOCS=100

# Альтернативная авторизация cloud.ru — ключ сервисного аккаунта, не сам API-токен.
# chat/completions/embeddings не принимают его напрямую, нужен обмен keyId/secret на
# короткоживущий IAM access-token. Используется только если LLM_API_KEY выше пуст.
# Создать: личный кабинет cloud.ru -> Пользователи -> Сервисные аккаунты -> нужный
# аккаунт -> Access Credentials -> Create API Key (Services: Foundation Models).
LLM_KEY_ID=
LLM_KEY_SECRET=
LLM_IAM_URL=https://iam.api.cloud.ru/api/v1/auth/token
